<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Trainspotting</title>
<meta name="description" content="Suomen tavarajunien livekartta ja tunnettuja katselupaikkoja." />
<link rel="icon" href="data:,">

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<style>
html,body{
  margin:0;
  padding:0;
  height:100%;
  font-family:Arial,Helvetica,sans-serif;
  background:#111;
  color:#fff;
}

body{
  display:flex;
  flex-direction:column;
}

header{
  background:#161616;
  border-bottom:1px solid #2d2d2d;
  padding:12px;
}

h1{
  margin:0 0 10px 0;
  font-size:24px;
  font-weight:700;
}

.controls{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

input,button,label{
  font-size:14px;
}

input{
  padding:8px;
  border-radius:8px;
  border:1px solid #444;
  background:#1f1f1f;
  color:#fff;
}

button{
  padding:8px 10px;
  border-radius:8px;
  border:1px solid #444;
  background:#242424;
  color:#fff;
  cursor:pointer;
}

button:hover{
  background:#333;
}

#status{
  margin-top:10px;
  font-size:13px;
  color:#ccc;
}

#map{
  flex:1;
  min-height:500px;
}

.legend{
  position:absolute;
  z-index:1000;
  left:12px;
  bottom:12px;
  background:rgba(20,20,20,.94);
  border:1px solid #444;
  border-radius:10px;
  padding:10px;
  font-size:13px;
}

.legend-row{
  margin-bottom:6px;
}

.dot{
  display:inline-block;
  width:11px;
  height:11px;
  border-radius:50%;
  margin-right:6px;
}

.red{background:#ff4d4d;}
.green{background:#3fd46c;}
.gray{background:#888;}
.blue{
  background:transparent;
  border:2px solid #4ba3ff;
  box-sizing:border-box;
}

.triangle-symbol{
  display:inline-block;
  width:0;
  height:0;
  border-left:7px solid transparent;
  border-right:7px solid transparent;
  border-bottom:13px solid #ffd24a;
  margin-right:6px;
}

.triangle-marker{
  width:0;
  height:0;
  border-left:12px solid transparent;
  border-right:12px solid transparent;
  border-bottom:20px solid #ffd24a;
  filter:drop-shadow(0 0 3px rgba(0,0,0,.8));
}

/* Popup scrollaus */
.cargo-popup,
.spot-popup,
.yard-popup{
  font-size:14px;
  line-height:1.45;
  max-height:260px;
  overflow-y:auto;
  padding-right:6px;
}

/* Sivulta aukeava paneeli */
#panelBackdrop{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  z-index:3000;
  display:none;
}

#sidePanel{
  position:fixed;
  top:0;
  right:-380px;
  width:360px;
  max-width:92vw;
  height:100%;
  background:#151515;
  border-left:1px solid #333;
  z-index:3001;
  transition:right .25s ease;
  overflow-y:auto;
  padding:18px;
  box-sizing:border-box;
}

#sidePanel.open{
  right:0;
}

#panelBackdrop.show{
  display:block;
}

#sidePanel h2{
  margin-top:0;
}

.close-btn{
  margin-top:14px;
  width:100%;
}

@media(max-width:700px){

  h1{
    font-size:20px;
  }

  .controls{
    flex-direction:column;
    align-items:stretch;
  }

  .legend{
    font-size:12px;
    max-width:220px;
  }

  #map{
    min-height:420px;
  }
}
</style>
</head>

<body>

<header>
  <h1>Trainspotting</h1>

  <div class="controls">
    <input id="searchInput" type="text" placeholder="Hae junanumerolla">

    <button onclick="applyFilters()">Hae</button>
    <button onclick="clearFilters()">Tyhjennä</button>
    <button onclick="openPanel()">Info</button>

    <label>
      <input type="checkbox" id="stoppedOnly" onchange="applyFilters()">
      Vain pysähtyneet
    </label>
  </div>

  <div id="status">Ladataan dataa...</div>
</header>

<div id="map"></div>

<div class="legend">
  <div class="legend-row"><span class="dot red"></span>Pysähtynyt</div>
  <div class="legend-row"><span class="dot green"></span>Liikkeessä</div>
  <div class="legend-row"><span class="dot gray"></span>Nopeus ei tiedossa</div>
  <div class="legend-row"><span class="dot blue"></span>Ratapiha</div>
  <div class="legend-row"><span class="triangle-symbol"></span>Katselupaikka</div>
</div>

<div id="panelBackdrop" onclick="closePanel()"></div>

<div id="sidePanel">
  <h2>Info</h2>

  <p>
    Tämä sivusto on tarkoitettu junien katseluun julkisilta ja turvallisilta paikoilta.
  </p>

  <p>
    Älä mene raiteille, ratapihoille, aidatuille alueille tai junien läheisyyteen.
  </p>

  <p>
    Reittiohjeet annetaan vain katselupaikoille.
  </p>

  <button class="close-btn" onclick="closePanel()">Sulje</button>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
const API = "https://rata.digitraffic.fi/api/v1";

const map = L.map("map").setView([64.8, 26.0], 6);

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{
  attribution:"© OpenStreetMap | Fintraffic"
}).addTo(map);

let trainLayer = L.layerGroup().addTo(map);
let yardLayer = L.layerGroup().addTo(map);
let spotLayer = L.layerGroup().addTo(map);

let latestCargo = [];
let stationNames = new Map();

/* ISOMMAT RATAPIHAYMPYRÄT */
const railYards = [
  {name:"Oulu ratapiha",lat:65.013,lon:25.472,radius:2600},
  {name:"Tampere ratapiha",lat:61.497,lon:23.766,radius:2600},
  {name:"Kouvola ratapiha",lat:60.869,lon:26.704,radius:3200},
  {name:"Pasila ratapiha",lat:60.205,lon:24.933,radius:2300},
  {name:"Riihimäki ratapiha",lat:60.738,lon:24.777,radius:2400},
  {name:"Seinäjoki ratapiha",lat:62.790,lon:22.842,radius:2300},
  {name:"Turku ratapiha",lat:60.455,lon:22.253,radius:2200},
  {name:"Joensuu ratapiha",lat:62.601,lon:29.763,radius:2200}
];

/* Katselupaikat */
const viewingSpots = [
  {
    name:"Heurekan silta",
    lat:60.2890,
    lon:25.0420,
    type:"Julkinen silta",
    desc:"Tunnettu katselupaikka Tikkurilassa."
  },
  {
    name:"Kiskopolun silta",
    lat:64.9949,
    lon:25.4701,
    type:"Julkinen silta",
    desc:"Hyvä näkymä Oulun ratapihan suuntaan."
  },
  {
    name:"Ruutana",
    lat:61.5288,
    lon:24.0136,
    type:"Katselupaikkaehdokas",
    desc:"Tunnettu kuvausalue."
  },
  {
    name:"Okeroinen",
    lat:60.9905,
    lon:25.5705,
    type:"Katselupaikkaehdokas",
    desc:"Lahden suunnan tunnettu paikka."
  }
];

const triangleIcon = L.divIcon({
  className:"",
  html:'<div class="triangle-marker"></div>',
  iconSize:[24,20],
  iconAnchor:[12,20]
});

function openPanel(){
  document.getElementById("panelBackdrop").classList.add("show");
  document.getElementById("sidePanel").classList.add("open");
}

function closePanel(){
  document.getElementById("panelBackdrop").classList.remove("show");
  document.getElementById("sidePanel").classList.remove("open");
}

function getSpeedState(speed){
  if(speed === 0) return {txt:"Pysähtynyt",color:"#ff4d4d"};
  if(speed > 0) return {txt:"Liikkeessä",color:"#3fd46c"};
  return {txt:"Ei tiedossa",color:"#888"};
}

async function loadStations(){
  try{
    const res = await fetch(API + "/metadata/stations");
    const data = await res.json();

    data.forEach(s=>{
      stationNames.set(s.stationShortCode,s.stationName);
    });
  }catch(e){}
}

async function loadData(){

  const status = document.getElementById("status");
  status.textContent = "Haetaan junia...";

  try{

    const [trainsRes,locRes] = await Promise.all([
      fetch(API + "/live-trains"),
      fetch(API + "/train-locations.geojson/latest")
    ]);

    const trains = await trainsRes.json();
    const locs = await locRes.json();

    const cargo = trains.filter(t =>
      t.trainCategory === "Cargo" &&
      t.cancelled !== true
    );

    const mapTrain = new Map();

    cargo.forEach(t=>{
      const key = t.trainNumber + "-" + t.departureDate;
      mapTrain.set(key,t);
    });

    latestCargo = [];

    locs.features.forEach(f=>{

      const p = f.properties;
      const key = p.trainNumber + "-" + p.departureDate;

      if(!mapTrain.has(key)) return;

      latestCargo.push({
        trainNumber:p.trainNumber,
        lat:f.geometry.coordinates[1],
        lon:f.geometry.coordinates[0],
        speed:p.speed,
        time:p.timestamp
      });

    });

    drawTrains();

  }catch(e){
    status.textContent = "Virhe datassa.";
  }
}

function drawTrains(){

  trainLayer.clearLayers();

  let data = latestCargo;

  const search = document.getElementById("searchInput").value.trim();
  const stopped = document.getElementById("stoppedOnly").checked;

  if(search){
    data = data.filter(t =>
      String(t.trainNumber).includes(search)
    );
  }

  if(stopped){
    data = data.filter(t => t.speed === 0);
  }

  data.forEach(t=>{

    const s = getSpeedState(t.speed);

    const marker = L.circleMarker([t.lat,t.lon],{
      radius:7,
      color:s.color,
      fillColor:s.color,
      fillOpacity:.9,
      weight:2
    });

    marker.bindPopup(`
      <div class="cargo-popup">
        <strong>Cargo ${t.trainNumber}</strong><br><br>
        Tila: ${s.txt}<br>
        Nopeus: ${t.speed ?? "?"} km/h<br>
        Päivitetty: ${new Date(t.time).toLocaleString("fi-FI")}
      </div>
    `);

    marker.addTo(trainLayer);

  });

  document.getElementById("status").textContent =
    "Kartalla " + data.length + " cargojunaa.";
}

function drawYards(){

  railYards.forEach(y=>{

    L.circle([y.lat,y.lon],{
      radius:y.radius,
      color:"#4ba3ff",
      fillColor:"#4ba3ff",
      fillOpacity:.08,
      weight:2
    })
    .bindPopup(`
      <div class="yard-popup">
        <strong>${y.name}</strong><br>
        Ratapiha-alue
      </div>
    `)
    .addTo(yardLayer);

  });

}

function drawSpots(){

  viewingSpots.forEach(s=>{

    L.marker([s.lat,s.lon],{
      icon:triangleIcon
    })
    .bindPopup(`
      <div class="spot-popup">
        <strong>${s.name}</strong><br><br>
        ${s.type}<br><br>
        ${s.desc}<br><br>
        <button onclick="window.open('https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lon}','_blank')">
          Reitti paikalle
        </button>
      </div>
    `)
    .addTo(spotLayer);

  });

}

function applyFilters(){
  drawTrains();
}

function clearFilters(){
  document.getElementById("searchInput").value="";
  document.getElementById("stoppedOnly").checked=false;
  drawTrains();
}

async function init(){
  await loadStations();
  drawYards();
  drawSpots();
  await loadData();

  setInterval(loadData,30000);
}

init();
</script>

</body>
</html>
